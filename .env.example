# ============================================================================
#  DevBrain configuration
#  ---------------------------------------------------------------------------
#  DevBrain reads every setting from APPLICATION (ENVIRONMENT) VARIABLES.
#  This file is an OPTIONAL local-development convenience.
#
#  Precedence, highest first:
#    1. Real environment variables   OS / container / CI / Azure App Settings
#    2. This .env file               local development only
#    3. Built-in defaults            non-secret values only
#
#  A real environment variable can NEVER be overridden by this file.
#
#  RECOMMENDED — no secrets on disk:
#      .\set-env.ps1                  saves them as Windows user variables
#      $env:OPENAI_API_KEY = "sk-..."  PowerShell, current session only
#      export OPENAI_API_KEY=sk-...    macOS / Linux
#
#  ALTERNATIVE — this file:
#    1. Copy it to a new file named exactly ".env"
#    2. Paste your real keys where indicated
#    3. Never commit .env (it is already in .gitignore)
#
#  Two switches:
#    DEVBRAIN_ENV_FILE=/path/to/other.env   read a different file
#    DEVBRAIN_IGNORE_ENV_FILE=1             ignore any file, environment only
# ============================================================================


# ----------------------------------------------------------------------------
#  1. OpenAI — generates the final written answer
#     Get a key: https://platform.openai.com/api-keys
# ----------------------------------------------------------------------------
OPENAI_API_KEY=sk-paste-your-openai-key-here

# Which chat model writes the answers.
# gpt-4o-mini is cheap and fast; gpt-4o is stronger but costs more.
OPENAI_MODEL=gpt-4o-mini

# 0.0 = strictly factual, sticks to your documents (recommended for RAG).
# Higher values (up to 1.0) make answers more creative but less reliable.
OPENAI_TEMPERATURE=0.0


# ----------------------------------------------------------------------------
#  2. Cohere — turns text into embeddings (vectors)
#     Get a key: https://dashboard.cohere.com/api-keys
# ----------------------------------------------------------------------------
COHERE_API_KEY=paste-your-cohere-key-here

# IMPORTANT: if you ever change this model you MUST re-ingest with
# `python ingest.py --reset`, because different models produce vectors of
# different sizes and meanings. Mixing them silently breaks search quality.
#   embed-english-v3.0      -> 1024 dimensions, English only
#   embed-multilingual-v3.0 -> 1024 dimensions, 100+ languages
COHERE_EMBED_MODEL=embed-english-v3.0


# ----------------------------------------------------------------------------
#  3. LangSmith — records a trace of every question for debugging
#     Get a key: https://smith.langchain.com  ->  Settings -> API Keys
# ----------------------------------------------------------------------------
# Set to "false" to turn tracing off entirely (the app still works fine).
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_paste-your-langsmith-key-here
LANGSMITH_PROJECT=devbrain

# REGION MATTERS. LangSmith runs separate US and EU instances, and a key issued
# by one is rejected by the other with a confusing "403 Forbidden" — the same
# error you would get from a completely invalid key.
#
# Look at the address bar when you are signed in to LangSmith:
#   smith.langchain.com      -> use the US endpoint (default below)
#   eu.smith.langchain.com   -> use https://eu.api.smith.langchain.com
#
# If tracing silently never appears, this line is the first thing to check.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com


# ----------------------------------------------------------------------------
#  4. PostgreSQL / pgvector
#     These defaults match docker-compose.yml exactly — leave them alone
#     unless you hit a port conflict (see below).
# ----------------------------------------------------------------------------
# Host ports. DevBrain uses 5433/5051 instead of the usual 5432/5050 so it can
# run at the same time as any other Postgres or pgAdmin you already have.
# Docker Compose reads these two values directly from this file.
POSTGRES_HOST_PORT=5433
PGADMIN_HOST_PORT=5051

# The port here MUST match POSTGRES_HOST_PORT above.
DATABASE_URL=postgresql+psycopg://devbrain:devbrain_pass@localhost:5433/devbrain

# Logical name for this set of documents inside Postgres. Think of it as a
# table name. Using a second collection lets you keep two separate knowledge
# bases in the same database.
COLLECTION_NAME=devbrain_docs


# ----------------------------------------------------------------------------
#  5. Ingestion & retrieval tuning (sensible defaults — safe to leave as-is)
# ----------------------------------------------------------------------------
# Folder that holds your source documents (relative to this project).
DATA_DIR=data

# Characters per chunk, and how much neighbouring chunks overlap.
# Bigger chunks = more context per hit but fuzzier matching.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# How many chunks to feed the LLM per question.
RETRIEVER_K=4

# Only return chunks at least this similar (0.0 = keep everything,
# 0.3-0.5 = filter out weak matches). Leave at 0.0 while you experiment.
RETRIEVER_SCORE_THRESHOLD=0.0


# ----------------------------------------------------------------------------
#  6. Web server
#     Read by run.py / the docs. DevBrain uses 8001 rather than 8000 to avoid
#     clashing with other local dev servers.
# ----------------------------------------------------------------------------
API_PORT=8001

# Host port for the CONTAINERISED app (docker compose --profile full up -d).
# Kept separate from API_PORT so a container can run on a different host port
# than a uvicorn you may already have on 8001.
API_HOST_PORT=8001

# ----------------------------------------------------------------------------
#  7. Administrator account
#     Seeded into Postgres on first start. Only the bcrypt HASH is stored —
#     the plaintext below never reaches the database.
#
#     Seeding only ever CREATES. If the account already exists it is left
#     alone, so changing the password later is not undone by a restart.
#     Change ADMIN_PASSWORD before deploying anywhere shared.
# ----------------------------------------------------------------------------
ADMIN_USERNAME=Shailendra.KS
ADMIN_PASSWORD=change-this-admin-password
ADMIN_FULL_NAME=Shailendra KS
ADMIN_EMAIL=
